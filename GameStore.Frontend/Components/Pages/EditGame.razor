@page "/editgame"
@page "/editgame/{id:int}"
@inject NavigationManager NavigationManager
@inject GameClient GameClient
@inject GenresClient GenresClient


<PageTitle>@title</PageTitle>
<h3>@title</h3>
  
    @if(genres is null || game is null)
    {
    <p class=""><em class="">Loading...</em>  </p>
    }
    else
    {
          <div class="row">
     <div class="col-md-4">
     <EditForm Model="@game" FormName="editGame" OnValidSubmit="HandleSubmmit">
      <DataAnnotationsValidator/>
      <ValidationSummary/>
        <div class="mb-3">
            <label for="name" class="form-label">Name:</label>
            <InputText id="name" @bind-value="game.Name" class="form-control"/> 
            <ValidationMessage For="() => game.Name" />
        </div>
            <div class="mb-3">
            <label for="genre" class="form-label">Genre:</label>
            <InputSelect id="genre" @bind-value="game.GenreId" class="form-select">
              <option value="">Select a Genre!</option>
              @foreach(Genre genre in genres)
              {
                 <option value="@genre.Id">@genre.Name</option>
              }
            </InputSelect>
            <ValidationMessage For="()=>game.GenreId"/>
            </div>
            <div class="mb-3">
                <label for="price" class="form-label">Price:</label>
                <InputNumber id="price" @bind-value="game.Price" class="form-control"/>
                <ValidationMessage For="() => game.Price"/>
            </div>

            <div class="mb-3">
                <label for="releaseDate" class="form-label">Release Date:</label>
                <InputDate id="releaseDate" @bind-value="game.ReleaseDate" class="form-control"/>
            </div>
          @* button *@
        <button type="submit" class="btn btn-primary btn-hover-warning">Save</button>
        <a class="btn btn-secondary" role="button" href="/">Cancel</a>

      </EditForm>
     </div>
    </div>
    }

  

@code {
    [Parameter]
     public int? Id {get; set;}
    [SupplyParameterFromForm]
    private  GameDetails? game {get; set;}
/*
private  GameDetails game {get; set;} = new()
   {
    Name = string.Empty,
    ReleaseDate = DateOnly.FromDateTime(DateTime.UtcNow)
    
   };
  private GenresClient genresClient = new();
    private GameClient gameClient = new (); 
*/
    private  Genre[]? genres;
    private string title = string.Empty;
    protected override void OnParametersSet()
    {    
        if(game is not null)
        {
            return;
        }
        if(Id is not null)
        {
            game = GameClient.GatGame(Id.Value);
            title = $"Edit {game.Name}";
        }
        else
         {
            game = new()
            {
                Name = string.Empty,
                ReleaseDate = DateOnly.FromDateTime(DateTime.UtcNow)
            };
            title = "New Game";
         }
    }
    protected override void OnInitialized()
    {
        genres = GenresClient.GetGenres();
    }


    private void HandleSubmmit()
    {
       ArgumentNullException.ThrowIfNull(game);
       if(Id is null)
       {
        GameClient.AddGame(game);
       }
       else
       {
        game.Id = Id.Value;
        GameClient.Updategame(game);
       }
        
        NavigationManager.NavigateTo("/");
    }
}
