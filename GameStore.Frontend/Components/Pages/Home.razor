@page "/"
@inject GameClient Client
@attribute [StreamRendering]

<PageTitle>Game Catalog</PageTitle>

<div class="mt-2">
    <a class="btn btn-primary" role="button" href="/editgame">New Game</a>
</div>

@if (games is null)
{
    <div class="mt-3 text-center text-muted">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p>Loading...</p>
    </div>
}
else if (games.Length == 0)
{
    <div class="mt-3 text-center text-muted">
        <p>No games found.</p>
    </div>
}
else
{
    <table class="table table-striped table-bordered table-hover mt-2">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Genre</th>
                <th class="text-end">Price</th>
                <th>Release Date</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var game in games)
            {
                <tr>
                    <td>@game.Id</td>
                    <td>@game.Name</td>
                    <td>@game.Genre</td>
                    <td class="text-end text-primary">@game.Price.ToString("c2")</td>
                    <td>@game.ReleaseDate</td>
                    <td>
                        <div class="d-flex">
                            <a class="btn btn-sm btn-primary" role="button" href="@GameUrl(game.Id)">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <button
                                class="btn btn-sm btn-danger ms-2"
                                data-bs-toggle="modal"
                                data-bs-target="@GetDeleteModalId(game)">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                        <Deletegame Game="@game" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private GameSummary[]? games;

    protected override async Task OnInitializedAsync()
    {
      games = await  Client.GetGamesAsync();
    }

    private static string GameUrl(int id) => $"/editgame/{id}";

    private string GetDeleteModalId(GameSummary game)
        => $"#{Deletegame.GetModelId(game)}";
}
